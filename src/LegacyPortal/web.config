<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- TESTBED-SEED TB-008: Hardcoded SQL connection string password in web.config (SEC-001) -->
    <add name="LegacyPortalDb" connectionString="Data Source=localhost;Initial Catalog=LedgerlyLegacy;User ID=sa;Password=LegacyPortalFakeSqlPassword2026#;" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <!-- TESTBED-SEED TB-009: Debug mode enabled in legacy ASP.NET configuration (CFG-002) -->
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- TESTBED-SEED TB-010: Custom errors disabled exposing verbose stack traces (CFG-002) -->
    <customErrors mode="Off" />

    <!-- TESTBED-SEED TB-011: Remote trace enabled exposing application internals (CFG-002) -->
    <trace enabled="true" localOnly="false" pageOutput="true" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
